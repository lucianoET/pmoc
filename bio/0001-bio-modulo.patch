+<!DOCTYPE html>
+<html lang="pt-br">
+<head>
+<meta charset="utf-8"/>
+<meta name="viewport" content="width=device-width,initial-scale=1"/>
+<meta name="theme-color" content="#1a1a18"/>
+<script>(function(){try{var t=localStorage.getItem('pmoc-tema');if(t!=='claro'&&t!=='escuro'){t=(typeof matchMedia==='function'&&matchMedia('(prefers-color-scheme: light)').matches)?'claro':'escuro'}document.documentElement.setAttribute('data-theme',t)}catch(e){document.documentElement.setAttribute('data-theme','escuro')}})()/* script classico de proposito: modulo ES e adiado, rodaria depois do primeiro desenho e reintroduziria a piscada de tema */</script>
+<title>PMOC Bio</title>
+<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
+<!-- Gerador de QR hospedado (qrcode-generator, MIT) — cópia do que
+     /refrigeracao já embarca, servido daqui pela regra de caminho raiz-absoluto. -->
+<script src="/bio/vendor/qrcode.js"></script>
+<link rel="stylesheet" href="../shared/pmoc.css"/>
+<style>
+/* Única cor declarada pelo módulo: a de destaque. Tema é da folha comum. */
+:root{--accent:#4f9a5c}
+
+/* ── painel do Início ──
+   Item de grid nasce com min-width:auto e cresce até o conteúdo: a tabela
+   de vencidos empurrava o cartão 44px para fora dos 375px, medido. Com
+   min-width:0 quem rola é o .tbl-wrap, como nas outras listas. */
+#view-inicio .section-split>.panel-card{min-width:0}
+
+/* ── grade de fichas ──
+   Cartão por espécie, foto em cima. Três colunas no computador, uma no
+   celular — mesma quebra de .section-split. */
+.fichas-grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
+@media (max-width:900px){.fichas-grade{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media (max-width:600px){.fichas-grade{grid-template-columns:1fr}}
+.ficha-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;cursor:pointer}
+.ficha-card:hover{border-color:var(--accent)}
+.ficha-foto{height:120px;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-size:40px;overflow:hidden}
+.ficha-foto img{width:100%;height:100%;object-fit:cover}
+.ficha-corpo{padding:10px 12px}
+.ficha-nome{font-weight:600;color:var(--text);font-size:14px}
+.ficha-cient{font-size:11px;color:var(--text3);font-style:italic;margin-bottom:6px}
+.ficha-linha{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
+
+/* ── detalhe (ficha, árvore, presença) ──
+   Bloco de texto com rótulo em caixa alta; quebra em qualquer ponto
+   porque o texto de "o que fazer" é livre. */
+.det-bloco{margin-bottom:14px}
+.det-rotulo{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text3);margin-bottom:4px}
+.det-texto{font-size:13px;color:var(--text2);line-height:1.5;overflow-wrap:anywhere}
+.det-foto{max-width:100%;max-height:240px;border-radius:8px;display:block;margin-bottom:12px}
+
+/* ── QR na tela ── */
+.qr-caixa{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
+.qr-caixa svg{width:120px;height:120px;background:#fff;padding:6px;border-radius:6px}
+
+/* ── etiqueta A6 ──
+   Só existe na impressão. Preto e branco, sem fundo, como os formulários
+   PMOC. Fora de @media print o bloco fica escondido; dentro, é a ÚNICA
+   coisa que imprime. */
+#etiqueta{display:none}
+@media print{
+  @page{size:A6;margin:6mm}
+  body>*:not(#etiqueta){display:none!important}
+  #etiqueta{display:block;font-family:Arial,Helvetica,sans-serif;color:#000;background:#fff;text-align:center}
+  #etiqueta .et-codigo{font-size:26pt;font-weight:700;letter-spacing:.04em;margin-top:4mm}
+  #etiqueta .et-nome{font-size:14pt;font-weight:600;margin-top:2mm}
+  #etiqueta .et-cient{font-size:10pt;font-style:italic}
+  #etiqueta svg{width:48mm;height:48mm;margin:5mm auto;display:block}
+  #etiqueta .et-rodape{font-size:8pt;margin-top:3mm}
+}
+</style>
+</head>
+<body>
+<div id="login-screen"></div>
+
+<!-- O miolo mora aqui, dentro do #app, antes de aplicarShell — o shell
+     põe o topo com afterbegin e o rodapé com beforeend. -->
+<div id="app">
+  <div class="main">
+
+    <div class="view active" id="view-inicio">
+      <div class="view-head">
+        <div>
+          <div class="view-title">Gestão biológica</div>
+          <div class="view-sub">Árvores etiquetadas, animais e pragas do terreno, e os serviços de poda e controle.</div>
+        </div>
+        <div class="section-row" style="margin-bottom:0">
+          <a class="btn btn-s btn-sm" href="/mapa">Abrir mapa</a>
+        </div>
+      </div>
+      <div id="inicio-kpis" class="kpi-row"></div>
+      <div id="inicio-aviso"></div>
+      <div class="section-split">
+        <div class="panel-card"><h3>Serviços vencidos</h3><div id="inicio-vencidos"></div></div>
+        <div class="panel-card"><h3>Presenças de risco alto</h3><div id="inicio-risco"></div></div>
+      </div>
+    </div>
+
+    <div class="view" id="view-fichas">
+      <div class="view-head">
+        <div>
+          <div class="view-title">Fichas</div>
+          <div class="view-sub">Guia de campo: o que é, que risco oferece, o que fazer ao encontrar.</div>
+        </div>
+        <div id="fichas-acoes"></div>
+      </div>
+      <div class="section-row">
+        <input id="fichas-busca" type="search" placeholder="Buscar por nome…" oninput="renderFichas()" style="flex:1;min-width:160px"/>
+        <div id="fichas-chips"></div>
+      </div>
+      <div id="fichas-lista" class="fichas-grade"></div>
+    </div>
+
+    <div class="view" id="view-arvores">
+      <div class="view-head">
+        <div>
+          <div class="view-title">Árvores</div>
+          <div class="view-sub">Inventário etiquetado. Cada árvore tem código, QR e histórico de poda.</div>
+        </div>
+        <div id="arvores-acoes"></div>
+      </div>
+      <div id="arvores-lista"></div>
+    </div>
+
+    <div class="view" id="view-presencas">
+      <div class="view-head">
+        <div>
+          <div class="view-title">Presenças</div>
+          <div class="view-sub">Onde os animais e as pragas ocorrem hoje. Estado do terreno, não histórico.</div>
+        </div>
+        <div id="presencas-acoes"></div>
+      </div>
+      <div id="presencas-lista"></div>
+    </div>
+
+    <div class="view" id="view-servicos">
+      <div class="view-head">
+        <div>
+          <div class="view-title">Serviços</div>
+          <div class="view-sub">Poda, controle de praga e monitoramento. Realizado com periodicidade gera o próximo.</div>
+        </div>
+        <div id="servicos-acoes"></div>
+      </div>
+      <div id="servicos-seletor"></div>
+      <div id="servicos-lista"></div>
+    </div>
+
+  </div>
+
+  <div class="overlay" id="overlay">
+    <div class="modal hidden" id="modal-ficha">
+      <div class="modal-hd"><h3 id="modal-ficha-titulo">Nova ficha</h3></div>
+      <div class="modal-body" id="modal-ficha-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Cancelar</button>
+        <button class="btn btn-p btn-sm" onclick="salvarFicha()">Salvar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-arvore">
+      <div class="modal-hd"><h3 id="modal-arvore-titulo">Nova árvore</h3></div>
+      <div class="modal-body" id="modal-arvore-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Cancelar</button>
+        <button class="btn btn-p btn-sm" onclick="salvarArvore()">Salvar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-presenca">
+      <div class="modal-hd"><h3 id="modal-presenca-titulo">Nova presença</h3></div>
+      <div class="modal-body" id="modal-presenca-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Cancelar</button>
+        <button class="btn btn-p btn-sm" onclick="salvarPresenca()">Salvar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-servico">
+      <div class="modal-hd"><h3 id="modal-servico-titulo">Novo serviço</h3></div>
+      <div class="modal-body" id="modal-servico-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Cancelar</button>
+        <button class="btn btn-p btn-sm" onclick="salvarServico()">Salvar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-realizar">
+      <div class="modal-hd"><h3>Marcar como realizado</h3></div>
+      <div class="modal-body" id="modal-realizar-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Cancelar</button>
+        <button class="btn btn-p btn-sm" onclick="confirmarRealizado()">Confirmar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-detalhe">
+      <div class="modal-hd"><h3 id="modal-detalhe-titulo">Detalhe</h3></div>
+      <div class="modal-body" id="modal-detalhe-corpo"></div>
+      <div class="modal-ft" id="modal-detalhe-acoes">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Fechar</button>
+      </div>
+    </div>
+    <div class="modal hidden" id="modal-confirmacao">
+      <div class="modal-hd"><h3 id="modal-confirmacao-titulo">Confirmar</h3></div>
+      <div class="modal-body" id="modal-confirmacao-corpo"></div>
+      <div class="modal-ft">
+        <button class="btn btn-s btn-sm" onclick="fecharModal()">Voltar</button>
+        <button class="btn btn-d btn-sm" onclick="executarConfirmacao()">Confirmar</button>
+      </div>
+    </div>
+  </div>
+</div>
+
+<!-- Etiqueta: preenchida por imprimirEtiqueta(), visível só na impressão. -->
+<div id="etiqueta"></div>
+
+<script type="module" src="/bio/app.js"></script>
+</body>
+</html>
